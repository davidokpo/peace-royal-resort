{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/api/bookings/intake",
      "dest": "/api/bookings/intake.js"
    },
    {
      "src": "/api/paystack/create-checkout",
      "dest": "/api/paystack/create-checkout.js"
    },
    {
      "src": "/api/paystack/verify",
      "dest": "/api/paystack/verify.js"
    },
    {
      "src": "/api/paystack/webhook",
      "dest": "/api/paystack/webhook.js"
    },
    {
      "src": "/assets/images/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=604800, stale-while-revalidate=2592000"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
