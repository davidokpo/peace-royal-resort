PORT=3001
NODE_ENV=development

# 1. Google Sheets (Optional if using Telegram/Email, recommended for booking logs)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_FRONTDESK_SPREADSHEET_ID=
GOOGLE_SHEETS_CAFE_SPREADSHEET_ID=
GOOGLE_SHEETS_RESTAURANT_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Bookings_Raw

# 2. Telegram Instant Phone Alerts (100% Free forever)
# Create a bot via @BotFather on Telegram to get the token
TELEGRAM_BOT_TOKEN=
# Your Telegram user ID or group chat ID (get via @userinfobot)
TELEGRAM_CHAT_ID=

# 3. Email Notifications (100% Free)
# Recipient email where booking alerts are delivered
NOTIFICATION_EMAIL_TO=
NOTIFICATION_EMAIL_FROM="Peace Royal Resort <onboarding@resend.dev>"
NOTIFICATION_EMAIL_NAME="Peace Royal Resort"

# Option 3A: Resend API (Free 3,000 emails/month, recommended for Vercel)
RESEND_API_KEY=

# Option 3B: SMTP / Gmail (Free 500 emails/day using Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Paystack
PAYSTACK_SECRET_KEY=

# Optional payout automation
PAYSTACK_TRANSFER_RECIPIENT_CODE=
PAYSTACK_MONIEPOINT_RECIPIENT_CODE=
PAYSTACK_OPAY_RECIPIENT_CODE=

# Optional admin protection for recipient creation
ADMIN_API_KEY=
